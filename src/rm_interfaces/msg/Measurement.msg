float64 x                               # 当前匹配装甲板在目标坐标系中的 x 坐标，单位 m
float64 y                               # 当前匹配装甲板在目标坐标系中的 y 坐标，单位 m
float64 z                               # 当前匹配装甲板在目标坐标系中的 z 坐标，单位 m
float64 yaw                             # 当前匹配装甲板自身的 yaw 姿态角，单位 rad
float64 armor_pitch                     # 当前匹配装甲板自身的 pitch 姿态角，单位 rad
float64 armor_roll                      # 当前匹配装甲板自身的 roll 姿态角，单位 rad
float64 center_yaw                      # 目标整车中心相对云台的观测 yaw 角，单位 rad
float64 pitch                           # 目标整车中心相对云台的观测 pitch 角，单位 rad
float64 distance                        # 目标整车中心到云台的观测距离，单位 m
