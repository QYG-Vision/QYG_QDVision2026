# 两个相机使用方共享 SDK 选择与架构检查，避免把 x86 库误链接到 Jetson。
include_guard(GLOBAL)

get_filename_component(_hik_default_root "${CMAKE_CURRENT_LIST_DIR}/../hikSDK" ABSOLUTE)
if(DEFINED ENV{HIK_SDK_ROOT} AND NOT "$ENV{HIK_SDK_ROOT}" STREQUAL "")
  set(_hik_default_root "$ENV{HIK_SDK_ROOT}")
endif()
set(HIK_SDK_ROOT "${_hik_default_root}" CACHE PATH "Hikrobot SDK root (include/ and lib/)")

if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
  set(_hik_arch arm64)
  set(_hik_machine b700)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$")
  set(_hik_arch amd64)
  set(_hik_machine 3e00)
else()
  message(FATAL_ERROR "Unsupported Hik SDK architecture: ${CMAKE_SYSTEM_PROCESSOR}")
endif()

set(HIK_SDK_INCLUDE_DIR "${HIK_SDK_ROOT}/include")
if(IS_DIRECTORY "${HIK_SDK_INCLUDE_DIR}/${_hik_arch}")
  set(HIK_SDK_INCLUDE_DIR "${HIK_SDK_INCLUDE_DIR}/${_hik_arch}")
endif()
set(HIK_SDK_LIBRARY_DIR "${HIK_SDK_ROOT}/lib/${_hik_arch}")
if(NOT IS_DIRECTORY "${HIK_SDK_LIBRARY_DIR}")
  # 官方安装包的单架构布局。
  set(HIK_SDK_LIBRARY_DIR "${HIK_SDK_ROOT}/lib/64")
endif()
if(NOT EXISTS "${HIK_SDK_INCLUDE_DIR}/MvCameraControl.h")
  message(FATAL_ERROR "Hik SDK headers missing; set -DHIK_SDK_ROOT=/path/to/MVS")
endif()
foreach(_hik_library libMvCameraControl.so libMvUsb3vTL.so)
  set(_hik_path "${HIK_SDK_LIBRARY_DIR}/${_hik_library}")
  if(NOT EXISTS "${_hik_path}")
    message(FATAL_ERROR "Hik SDK library missing: ${_hik_path}")
  endif()
  file(READ "${_hik_path}" _hik_magic OFFSET 0 LIMIT 6 HEX)
  file(READ "${_hik_path}" _hik_actual_machine OFFSET 18 LIMIT 2 HEX)
  if(NOT _hik_magic STREQUAL "7f454c460201" OR NOT _hik_actual_machine STREQUAL _hik_machine)
    message(FATAL_ERROR
      "Hik SDK architecture mismatch: ${_hik_path}; expected ${_hik_arch}. "
      "Install the matching Linux SDK and set -DHIK_SDK_ROOT=/path/to/MVS")
  endif()
endforeach()
set(HIK_SDK_LIBRARY "${HIK_SDK_LIBRARY_DIR}/libMvCameraControl.so")
message(STATUS "Hik SDK: ${HIK_SDK_ROOT} (${_hik_arch})")
