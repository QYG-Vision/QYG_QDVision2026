# 在已经验证的 CPU 镜像上补齐与宿主机一致的 Jetson GPU 开发组件。
ARG BASE_IMAGE=qyg-vision:jetson-jp6
FROM ${BASE_IMAGE}

ARG L4T_APT_BRANCH=r36.5
ARG TENSORRT_VERSION=10.3.0.30-1+cuda12.5
ARG CUDA_PACKAGE_VERSION=12.6.68-1

RUN test "$(dpkg --print-architecture)" = arm64 && \
    curl -fsSL --retry 3 https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
      | gpg --dearmor -o /usr/share/keyrings/nvidia-jetson.gpg && \
    printf '%s\n' \
      "deb [signed-by=/usr/share/keyrings/nvidia-jetson.gpg] https://repo.download.nvidia.com/jetson/common ${L4T_APT_BRANCH} main" \
      "deb [signed-by=/usr/share/keyrings/nvidia-jetson.gpg] https://repo.download.nvidia.com/jetson/t234 ${L4T_APT_BRANCH} main" \
      > /etc/apt/sources.list.d/nvidia-jetson.list && \
    apt-get update && apt-get install -y --no-install-recommends \
      "cuda-nvcc-12-6=${CUDA_PACKAGE_VERSION}" \
      "cuda-cudart-dev-12-6=${CUDA_PACKAGE_VERSION}" \
      "libnvinfer-dev=${TENSORRT_VERSION}" \
      "libnvonnxparsers-dev=${TENSORRT_VERSION}" \
      "python3-libnvinfer=${TENSORRT_VERSION}" \
      "libnvinfer-bin=${TENSORRT_VERSION}" \
      python3-venv python3-pip python3-opencv && \
    rm -rf /var/lib/apt/lists/*

# TensorRT 的共享库还依赖 cuDLA 运行库，即使本机使用的是 GPU 推理。
RUN apt-get update && apt-get install -y --no-install-recommends \
      "libcudla-12-6=${CUDA_PACKAGE_VERSION}" && \
    rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME=/usr/local/cuda-12.6
ENV CUDAToolkit_ROOT=/usr/local/cuda-12.6
ENV PATH=/usr/local/cuda-12.6/bin:${PATH}
ENV ENABLE_TENSORRT=ON
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
